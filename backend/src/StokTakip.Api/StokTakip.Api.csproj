<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>StokTakip.Api</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.*" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.*">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="ClosedXML" Version="0.105.*" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.*" />
    <!-- Sadece Microsoft.ML: Poisson regresyon yönetilen kod, ARM64 (Apple Silicon) dahil çalışır.
         Microsoft.ML.TimeSeries (SSA) Intel MKL gerektirir, ARM64'te çalışmaz; bilinçli olarak eklenmedi. -->
    <PackageReference Include="Microsoft.ML" Version="5.0.*" />
  </ItemGroup>

</Project>
